# ==============================================================================
# Ubuntu-LS Monitor: Environment Configuration Example
# Copy this file to '.env' and fill in the values for your environment.
# NEVER commit the actual '.env' file to your Git repository!
# ==============================================================================

# Application Environment (production / development)
APP_ENV=production
DEBUG=false

# Server Bind Settings
HOST=127.0.0.1
PORT=8005

# Base URL (FQDN used for OGP resolution, redirection, and CORS)
BASE_URL=https://<your-subdomain>.<your-domain>.com

# ------------------------------------------------------------------------------
# WebAuthn / Passkey Authentication Settings
# ------------------------------------------------------------------------------
# Relying Party (RP) Human-readable name
RP_NAME="Home Server Monitor"

# Relying Party Identifier (Effective domain name without protocol/port)
RP_ID=<your-subdomain>.<your-domain>.com

# Expected Origin for WebAuthn response validation (Exact scheme + host)
EXPECTED_ORIGIN=https://<your-subdomain>.<your-domain>.com

# User verification requirement ("preferred", "required", or "discouraged")
USER_VERIFICATION=preferred

# WebAuthn Challenge validity timeout in seconds (Default: 60)
CHALLENGE_TIMEOUT_SECONDS=60

# Invite token validity duration in minutes (Default: 15)
INVITE_TOKEN_EXPIRY_MINUTES=15

# Session Cookie Secret Key (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=replace_with_a_secure_random_hex_string_at_least_32_bytes

# Session Cookie Expiration in seconds (Default: 86400 = 24 hours)
SESSION_MAX_AGE_SECONDS=86400

# Cookie security settings (Set to false only during local HTTP dev if needed)
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# ------------------------------------------------------------------------------
# Storage, Configuration & Audit Paths
# ------------------------------------------------------------------------------
# SQLite database path (Permissions will be enforced to 0600 on POSIX)
DB_PATH=data/dashboard.db

# Path to the operational whitelist configuration YAML file
CONFIG_PATH=config.yaml

# Path for structured JSON audit logging
AUDIT_LOG_PATH=logs/audit.jsonl

# Docker socket path (Default: /var/run/docker.sock)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=https://<your-subdomain>.<your-domain>.com
